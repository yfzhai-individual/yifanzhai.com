---
import BaseLayout from './BaseLayout.astro';

interface Heading { depth: number; slug: string; text: string; }
interface Props {
  title: string;
  description: string;
  eyebrow: string;
  meta?: string;
  tags?: string[];
  headings?: Heading[];
  backHref: string;
  backLabel: string;
  type?: 'article' | 'website';
}

const { title, description, eyebrow, meta, tags = [], headings = [], backHref, backLabel, type = 'article' } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout title={title} description={description} type={type} image={null}>
  <article class="shell">
    <header class="article-head">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {meta && <p class="article-meta" style="margin-top: 1.25rem">{meta}</p>}
      {tags.length > 0 && <ul class="tag-list" style="margin-top: .8rem">{tags.map((tag) => <li class="tag">{tag}</li>)}</ul>}
    </header>
    <div class="section prose-wrap">
      <div class="prose"><slot /></div>
      {tocHeadings.length > 0 && (
        <nav class="toc" aria-label="Table of contents">
          <p>On this page</p>
          <ol>{tocHeadings.map((heading) => <li style={heading.depth === 3 ? 'padding-left: .8rem' : undefined}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
        </nav>
      )}
    </div>
    <p style="padding-block: 2rem 5rem"><a class="text-link" href={backHref}>Back to {backLabel}</a></p>
  </article>
</BaseLayout>
