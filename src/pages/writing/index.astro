---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout title="Writing" description="Technical writing and notes by Yifan Zhai.">
  <PageHeader eyebrow="Notes & essays" title="Writing" description="Working notes on software engineering, product security, automation, and whatever becomes useful to explain." />
  <section class="section shell">
    {tags.length > 0 && <ul class="tag-list" aria-label="Writing tags" style="margin-bottom: 2rem">{tags.map((tag) => <li class="tag">{tag}</li>)}</ul>}
    {posts.length ? (
      <ul class="rule-list">
        {posts.map((post) => (
          <li class="rule-item">
            <time class="rule-item-meta" datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
            <div><a href={`/writing/${post.id}/`}>{post.data.title}</a><p class="muted" style="margin-top: .35rem; font-size: .9rem">{post.data.description}</p></div>
            <span aria-hidden="true">→</span>
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty-state"><div><strong>The notebook is open.</strong><p>No posts are public yet. Markdown and MDX support, syntax highlighting, tags, tables of contents, and RSS are already wired in.</p></div><a class="text-link" href="/rss.xml">RSS feed</a></div>
    )}
  </section>
</BaseLayout>
