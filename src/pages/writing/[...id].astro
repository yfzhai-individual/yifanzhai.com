---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { formatCalendarDate } from '../../utils/dates';
import { isVisibleWritingPost } from '../../utils/writing';

export async function getStaticPaths() {
  const posts = await getCollection('writing', isVisibleWritingPost);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const date = formatCalendarDate(post.data.publishedAt);
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  eyebrow={post.data.draft ? 'Writing / Draft' : 'Writing'}
  meta={date}
  tags={post.data.tags}
  headings={headings}
  backHref="/writing/"
  backLabel="writing"
>
  <Content />
</ArticleLayout>
