---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';
import { compareDatesDescending, formatCalendarDate, toCalendarDateValue } from '../utils/dates';
import { isVisibleWritingPost } from '../utils/writing';

const posts = await getCollection('writing', (post) => isVisibleWritingPost(post) && !post.data.draft);
const projects = await getCollection('projects', ({ data }) => !data.draft && Boolean(data.publishedAt));
const latestContent = [
  ...posts.map((post) => ({
    kind: 'Writing',
    title: post.data.title,
    description: post.data.description,
    publishedAt: post.data.publishedAt,
    href: `/writing/${post.id}/`,
  })),
  ...projects.flatMap((project) => project.data.publishedAt ? [{
    kind: 'Project',
    title: project.data.title,
    description: project.data.summary,
    publishedAt: project.data.publishedAt,
    href: `/projects/${project.id}/`,
  }] : []),
]
  .sort((a, b) => compareDatesDescending(a.publishedAt, b.publishedAt) || a.href.localeCompare(b.href))
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Software · Security · Automation</p>
        <h1 class="display">Yifan<br />Zhai<em>.</em></h1>
        <p class="lede">I build dependable software, strengthen the systems around it, and use automation to make careful work scale.</p>
        <div class="link-row" aria-label="Profile links">
          <a class="text-link" href={site.social.github} rel="me">GitHub</a>
          <a class="text-link" href={site.social.linkedin} rel="me">LinkedIn</a>
        </div>
      </div>
      <p class="hero-note"><span>Current focus</span>Engineering secure, useful systems at the intersection of product thinking and AI.</p>
    </div>
  </section>

  {latestContent.length > 0 && (
    <section class="section shell latest-content">
      <p class="eyebrow">New on the site</p>
      <ul class="latest-content-list">
        {latestContent.map((item) => (
          <li class="latest-content-item">
            <a href={item.href}>
              <div class="latest-content-meta">
                <span>{item.kind}</span>
                <time datetime={toCalendarDateValue(item.publishedAt)}>{formatCalendarDate(item.publishedAt, 'short')}</time>
              </div>
              <div class="latest-content-copy">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
              <span class="latest-content-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
