---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';

const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured)).slice(0, 3);
const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Software · Security · Automation</p>
        <h1 class="display">Yifan<br />Zhai<em>.</em></h1>
        <p class="lede">I build dependable software, strengthen the systems around it, and use automation to make careful work scale.</p>
        <div class="link-row" aria-label="Profile links">
          <a class="text-link" href={site.social.github} rel="me">GitHub</a>
          <a class="text-link" href={site.social.linkedin} rel="me">LinkedIn</a>
        </div>
      </div>
      <p class="hero-note"><span>Current focus</span>Engineering secure, useful systems at the intersection of product thinking and AI.</p>
    </div>
  </section>

  <section class="section shell">
    <div class="section-head">
      <p class="eyebrow">01 / Projects</p>
      <div><h2 class="section-title">Selected work</h2><p class="section-intro">A focused archive of things built, explored, and learned.</p></div>
    </div>
    {projects.length ? (
      <ul class="rule-list">
        {projects.map((project) => <li class="rule-item"><span class="rule-item-meta">{project.data.status}</span><a href={`/projects/${project.id}/`}>{project.data.title}</a><span aria-hidden="true">→</span></li>)}
      </ul>
    ) : (
      <div class="empty-state"><div><strong>The archive starts quietly.</strong><p>Project notes and case studies will appear here as they are ready.</p></div><a class="text-link" href="/projects/">View project structure</a></div>
    )}
  </section>

  <section class="section shell">
    <div class="section-head">
      <p class="eyebrow">02 / Writing</p>
      <div><h2 class="section-title">Recent notes</h2><p class="section-intro">Technical writing on software, security, automation, and the details between them.</p></div>
    </div>
    {posts.length ? (
      <ul class="rule-list">
        {posts.map((post) => <li class="rule-item"><time class="rule-item-meta" datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</time><a href={`/writing/${post.id}/`}>{post.data.title}</a><span aria-hidden="true">→</span></li>)}
      </ul>
    ) : (
      <div class="empty-state"><div><strong>Notes are coming.</strong><p>The writing system is ready for MDX, tags, code, and long-form technical work.</p></div><a class="text-link" href="/writing/">Visit writing</a></div>
    )}
  </section>
</BaseLayout>
