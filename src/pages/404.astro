---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist.">
  <section class="hero shell">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">HTTP 404 / NXDOMAIN</p>
        <h1 class="display">No route<br />found<em>.</em></h1>
        <p class="lede">The address resolved, but the page did not. It may have moved—or never existed.</p>
        <p><a class="text-link" href="/">Return home</a></p>
      </div>
      <p class="hero-note"><span>diagnostic</span>status: not_found<br />recovery: /</p>
    </div>
  </section>
</BaseLayout>
