---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="Work" description="Selected experience and areas of practice.">
  <PageHeader eyebrow="Experience" title="Work" description="A selective record of roles, responsibilities, and work worth remembering." />
  <section class="section shell">
    <div class="section-head">
      <p class="eyebrow">Timeline</p>
      <div><h2 class="section-title">Built to grow over time.</h2><p class="section-intro">Career entries will live here when they are ready. Each one can hold a concise role summary, areas of ownership, and selected work—without turning into a résumé dump.</p></div>
    </div>
    <div class="empty-state"><div><strong>No public work history yet.</strong><p>Employer names, dates, and achievements have intentionally not been invented.</p></div><span class="mono muted" style="font-size: .75rem">Add entries in this page</span></div>
  </section>
</BaseLayout>
