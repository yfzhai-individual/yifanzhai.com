---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../config';
---

<BaseLayout title="Contact" description="Get in touch with Yifan Zhai.">
  <PageHeader eyebrow="Contact" title="Say hello." description="The best conversations usually start with a clear note and a little context." />
  <section class="section shell">
    <div class="empty-state">
      <div><strong>Find me online.</strong><p>LinkedIn is the best public place to get in touch. Email and résumé details stay private for now.</p></div>
      <div class="link-row" style="margin-top: 0">
        <a class="text-link" href={site.social.linkedin} rel="me">LinkedIn</a>
        <a class="text-link" href={site.social.github} rel="me">GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>
